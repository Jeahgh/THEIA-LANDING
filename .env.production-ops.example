# Plantilla solo para operar migraciones de producción desde un equipo confiable.
# Copia como .env.production-ops.local y completa el valor. No se carga en cPanel.
# No reutilices DATABASE_URL: el nombre explícito evita apuntar a producción por error.
THEIA_PRODUCTION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
