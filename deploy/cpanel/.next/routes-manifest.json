{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/uploads/:folder/:fileName",
        "destination": "/api/uploads/:folder/:fileName",
        "regex": "^/uploads(?:/([^/]+?))(?:/([^/]+?))(?:/)?$"
      }
    ],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/competencias/[id]",
      "regex": "^/admin/competencias/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/competencias/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/equipo/[id]",
      "regex": "^/admin/equipo/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/equipo/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
