# Plantilla exclusiva de desarrollo local.
# Copia este archivo como .env.development.local; nunca pongas aquí producción.

# PostgreSQL local iniciado por Docker en localhost:5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/theia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/theia?schema=public"

# Auth.js local. Genera un valor largo y aleatorio para AUTH_SECRET.
AUTH_SECRET="REEMPLAZAR_CON_UN_SECRETO_LOCAL_LARGO"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales OAuth de una aplicación Google configurada para localhost.
AUTH_GOOGLE_ID="REEMPLAZAR_CON_CLIENT_ID_DE_DESARROLLO"
AUTH_GOOGLE_SECRET="REEMPLAZAR_CON_CLIENT_SECRET_DE_DESARROLLO"

# Correo de desarrollo opcional. Sin proveedor, los enlaces se muestran solo
# en la consola local. Descomenta SMTP o RESEND_API_KEY si quieres enviar.
# EMAIL_FROM="Theia desarrollo <contacto@example.com>"
# SMTP_HOST="mail.example.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="contacto@example.com"
# SMTP_PASS="REEMPLAZAR_CON_PASSWORD_DE_DESARROLLO"
# RESEND_API_KEY="re_REEMPLAZAR_CON_CLAVE_DE_DESARROLLO"

NEXT_TELEMETRY_DISABLED="1"
