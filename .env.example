# PostgreSQL. Usa DIRECT_URL para migraciones si DATABASE_URL pasa por un pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js
AUTH_SECRET="REEMPLAZAR_CON_UN_SECRETO_LARGO"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="REEMPLAZAR"
AUTH_GOOGLE_SECRET="REEMPLAZAR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Correo. Configura SMTP o RESEND_API_KEY, no ambos necesariamente.
EMAIL_FROM="Theia <contacto@example.com>"
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contacto@example.com"
SMTP_PASS="REEMPLAZAR"
# RESEND_API_KEY="re_REEMPLAZAR"
