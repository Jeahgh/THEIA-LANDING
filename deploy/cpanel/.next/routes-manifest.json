    },
    {
      "page": "/admin/testimonios/[id]",
      "regex": "^/admin/testimonios/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/testimonios/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/uploads/[folder]/[fileName]",
      "regex": "^/api/uploads/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPfolder": "nxtPfolder",
        "nxtPfileName": "nxtPfileName"
      },
      "namedRegex": "^/api/uploads/(?<nxtPfolder>[^/]+?)/(?<nxtPfileName>[^/]+?)(?:/)?$"
    }
  ],
