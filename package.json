{
  "name": "club-triatlon-thia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cpanel": "node node_modules/next/dist/bin/next build --webpack",
    "start": "next start --port 3000",
    "start:cpanel": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "cpanel:doctor": "node scripts/cpanel-doctor.cjs",
    "cpanel:fix-prisma-platform": "node scripts/cpanel-fix-prisma-platform.cjs",
    "cpanel:install-app": "node scripts/cpanel-install.cjs",
    "cpanel:prepare": "node node_modules/prisma/build/index.js generate && node node_modules/next/dist/bin/next build --webpack"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/get-platform": "7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
