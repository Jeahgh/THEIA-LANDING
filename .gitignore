# Dependencies
/node_modules/
/.pnp
.pnp.*
/nodevenv/

# Generated source and local builds
/.next/
/out/
/build/
/src/generated/prisma/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Temporary cPanel artifact directories
/deploy/.cpanel-build-*/

# Environment and secrets
.env
.env.*
!.env.example

# Logs and diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/tmp/

# Tooling and OS files
.DS_Store
*.pem
/.vercel/
vite-dev*.log

# deploy/cpanel is intentionally tracked: it is the Linux standalone artifact
# consumed by cPanel. Rebuild it only with `npm run build:cpanel`.
/deploy/cpanel/.next/cache/

# Runtime uploads must not make the cPanel Git working tree dirty.
# Existing files remain tracked; new files created by the app are ignored.
/public/uploads/**
/deploy/cpanel/public/uploads/**
