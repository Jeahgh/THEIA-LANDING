{
  "name": "club-triatlon-thia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/local-tools.cjs dev",
    "dev:web": "node scripts/local-tools.cjs dev:web",
    "build": "node scripts/local-tools.cjs build",
    "build:container": "node scripts/container-tools.cjs build",
    "build:cpanel": "node scripts/build-cpanel.cjs",
    "start": "node server.js",
    "lint": "eslint",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/auth-session-state.test.mjs",
    "test:seo": "node --test tests/seo-config.test.mjs",
    "test:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/auth-session-state.test.mjs tests/admin-authorization.test.mjs tests/security-config.test.mjs tests/http-body.test.mjs tests/image-upload.test.mjs tests/external-url.test.mjs tests/email-transport.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:up": "node scripts/local-tools.cjs db:up",
    "db:stop": "node scripts/local-tools.cjs db:stop",
    "db:status": "node scripts/local-tools.cjs db:status",
    "db:migrate": "node scripts/local-tools.cjs db:migrate",
    "db:seed": "node scripts/local-tools.cjs db:seed",
    "db:studio": "node scripts/local-tools.cjs db:studio",
    "db:status:production": "node scripts/production-db.cjs status",
    "db:deploy:production": "node scripts/production-db.cjs deploy",
    "db:deploy:container": "node scripts/container-tools.cjs db:deploy",
    "db:seed:container": "node scripts/container-tools.cjs db:seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "nodemailer-v9": "npm:nodemailer@9.0.5",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/env": "16.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
