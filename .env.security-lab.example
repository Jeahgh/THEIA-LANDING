# Plantilla exclusiva para una VM de laboratorio en red VirtualBox Host-Only.
# Copia como .env.security-lab, genera secretos nuevos y nunca reutilices
# credenciales de desarrollo o produccion.
THEIA_LAB_BIND_IP=192.168.56.20
POSTGRES_DB=theia_lab
POSTGRES_USER=theia_lab_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_HEX_ALEATORIO_SOLO_LAB
AUTH_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_SOLO_LAB
AUTH_URL=http://192.168.56.20:3000
NEXT_PUBLIC_APP_URL=http://192.168.56.20:3000
AUTH_GOOGLE_ID=lab-google-disabled
AUTH_GOOGLE_SECRET=lab-google-disabled
NEXT_TELEMETRY_DISABLED=1
